# Environment mode
# Set to 'production' for Turso database, leave empty or 'development' for local SQLite
NODE_ENV=development

# Server port (optional, defaults to 3001)
PORT=3001

# ================================================
# DATABASE CONFIGURATION
# ================================================
# Development: Uses local SQLite file (bessi.db)
# Production: Uses Turso (cloud SQLite)

# Turso Keys (required for NODE_ENV=production)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_TOKEN=your-turso-auth-token

# ================================================
# ABLY (for WebSocket support in production)
# ================================================
# Required for real-time booth features when deploying to Vercel.
# Get your API key from https://ably.com
ABLY_API_KEY=your-ably-api-key

# ================================================
# GOOGLE DOCS
# ================================================
# No authentication needed - Google Docs are fetched via public export URL.
# Just make sure your docs are shared with "Anyone with the link can view".

# ================================================
# GOOGLE OAUTH (for login)
# ================================================
# Get credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SESSION_SECRET=your-random-session-secret

# Allowed emails (comma-separated list)
# If set, only these emails can log in. Leave empty to allow all.
ALLOWED_EMAILS=e@eikisig.is,david.berndsen@gmail.com,karirogg@gmail.com

# ================================================
# VERCEL DEPLOYMENT NOTES
# ================================================
# 1. Set NODE_ENV=production in Vercel Environment Variables
# 2. Set TURSO_DATABASE_URL and TURSO_TOKEN
# 3. Set ABLY_API_KEY for real-time booth features
#
# With Ably configured, the booth real-time features will work on Vercel.
# The app automatically uses Ably in production and native WebSocket in development.
