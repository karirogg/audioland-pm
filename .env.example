# Environment mode
NODE_ENV=development

# Server port (optional, defaults to 3001)
PORT=3001

# ================================================
# SUPABASE (required)
# ================================================
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ================================================
# ABLY (for WebSocket support in production)
# ================================================
# Required for real-time booth features when deploying to Vercel.
# Get your API key from https://ably.com
ABLY_API_KEY=your-ably-api-key

# ================================================
# GOOGLE DOCS
# ================================================
# No authentication needed - Google Docs are fetched via public export URL.
# Just make sure your docs are shared with "Anyone with the link can view".

# ================================================
# VERCEL DEPLOYMENT NOTES
# ================================================
# 1. Set all SUPABASE_* environment variables
# 2. Set ABLY_API_KEY for real-time booth features
# 3. Enable Google OAuth in Supabase: Authentication -> Providers -> Google
#
# With Ably configured, the booth real-time features will work on Vercel.
# The app automatically uses Ably in production and native WebSocket in development.
