# Environment mode
# Set to 'production' for Turso database, leave empty or 'development' for local SQLite
NODE_ENV=development

# Server port (optional, defaults to 3001)
PORT=3001

# ================================================
# DATABASE CONFIGURATION
# ================================================
# Development: Uses local SQLite file (bessi.db)
# Production: Uses Turso (cloud SQLite)

# Turso Keys (required for NODE_ENV=production)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_TOKEN=your-turso-auth-token

# ================================================
# GOOGLE DOCS
# ================================================
# No authentication needed - Google Docs are fetched via public export URL.
# Just make sure your docs are shared with "Anyone with the link can view".

# ================================================
# VERCEL DEPLOYMENT NOTES
# ================================================
# 1. Set NODE_ENV=production in Vercel Environment Variables
# 2. Set TURSO_DATABASE_URL and TURSO_TOKEN
#
# IMPORTANT: WebSockets are NOT supported on Vercel serverless.
# The booth real-time features will not work on Vercel.
# Consider using Railway, Render, or Fly.io for full WebSocket support.
